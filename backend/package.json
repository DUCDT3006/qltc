{
  "name": "qltc-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "tsx --test tests/v2_suite.test.ts tests/ledger_race.test.ts tests/auth_regression.test.ts tests/pagination.test.ts tests/backup_foreign_keys.test.ts tests/reset_income_scope.test.ts",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute qltc-db --local --file=./schema.sql",
    "d1:init:prod": "wrangler d1 execute qltc-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "wrangler": "^4.157.0"
  }
}
