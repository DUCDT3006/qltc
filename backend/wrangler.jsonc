{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qltc-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "FRONTEND_ORIGIN": "https://qltc-app.dtd-store.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qltc-db",
      "database_id": "1dcba37d-26a3-406f-a6bc-f183210edb4e"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "4a0f927b0e334f93b7584fe422be0ab7"
    }
  ],
  "triggers": {
    "crons": ["0 1,8,13 * * *"]
  }
}
